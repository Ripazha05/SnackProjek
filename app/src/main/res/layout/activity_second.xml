<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Judul Snack -->
            <TextView
                android:id="@+id/tvJudul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Japota Potato Chips"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Gambar Snack -->
            <ImageView
                android:id="@+id/imgSnack"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/japota"
                android:contentDescription="Gambar Snack"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvJudul"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Komposisi Gizi -->
            <TextView
                android:id="@+id/tvGizi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Komposisi Gizi (per 30g):\n\n• Energi Total: 160 kcal\n• Lemak Total: 10g\n• Protein: 2g\n• Karbohidrat Total: 15g\n• Natrium / Garam: 140mg"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/imgSnack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>