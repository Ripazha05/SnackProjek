<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bm_background"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pencarian Perabot"
        android:textColor="@color/bm_dark"
        android:textSize="22sp"
        android:fontFamily="@font/inter_bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Cari nama perabot yang Anda inginkan"
        android:textColor="@color/bm_gray"
        android:textSize="14sp"
        android:fontFamily="@font/inter_regular" />

    <!-- SearchView -->
    <SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:iconifiedByDefault="false"
        android:queryHint="Cari (contoh: Sofa)..."
        android:background="@drawable/bg_edittext" />

    <!-- ListView for search results -->
    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_product_card"
        android:divider="#E5E7EB"
        android:dividerHeight="1dp" />

</LinearLayout>
