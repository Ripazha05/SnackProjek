<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bm_background"
    android:padding="24dp">

    <!-- Top Skip Button -->
    <TextView
        android:id="@+id/btnSkipOnboarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:text="Lewati"
        android:textColor="@color/bm_gray"
        android:textSize="14sp"
        android:fontFamily="@font/inter_medium"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Center Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgOnboarding"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/bm_logo"
            android:scaleType="centerInside"
            android:background="@drawable/bg_circle_avatar"
            android:padding="20dp"
            android:contentDescription="Ilustrasi Onboarding" />

        <TextView
            android:id="@+id/tvOnboardingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Koleksi Perabot Terlengkap"
            android:textColor="@color/bm_dark"
            android:textSize="22sp"
            android:fontFamily="@font/inter_bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvOnboardingDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Temukan berbagai perabot rumah tangga berkualitas tinggi dengan harga terbaik."
            android:textColor="@color/bm_gray"
            android:textSize="14sp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

    <!-- Bottom Action Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btnNextOnboarding"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button"
            android:text="Lanjut"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_semibold"
            android:stateListAnimator="@null" />

    </LinearLayout>

</RelativeLayout>
