<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bm_background">

    <include
        layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Profile Picture -->
            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/bg_circle_avatar"
                android:padding="12dp"
                android:src="@drawable/bm_logo"
                android:scaleType="centerCrop"
                android:contentDescription="Foto Profil" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Rifa Aulia"
                android:textColor="@color/bm_dark"
                android:textSize="22sp"
                android:fontFamily="@font/inter_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Android Developer &amp; Mobile Student"
                android:textColor="@color/bm_blue"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold" />

            <!-- Card Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_menu_card"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Item: Sosial Media -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sosial Media"
                    android:textColor="@color/bm_blue"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Instagram: @Ripantsu\nGitHub: github.com/Ripazha05"
                    android:textColor="@color/bm_dark"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_regular" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Item: Hobi -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hobi"
                    android:textColor="@color/bm_blue"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Bermain Game,Photography"
                    android:textColor="@color/bm_dark"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_regular" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Item: Kekuatan Terbesar -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kekuatan Terbesar"
                    android:textColor="@color/bm_blue"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="mudah beradaptasi dengan teknologi baru, serta konsisten dalam menyelesaikan proyek tepat waktu."
                    android:textColor="@color/bm_dark"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter_regular" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
